<!--
  The editor's look, after the Underworld editor's (UltimaUnderworldEditorAvalonia, src/UwEditor.Look): a Light and
  a Dark colour scheme (View > Theme; Light by default) and a compact, classic layout in the manner of Windows XP / 7
  dialogs: framed lists, tabs joined to their page, buttons with a gradient and a border, header bars. Fluent's own
  sizes are tightened through its resource keys; font sizes are not changed.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Fluent's sizes, tightened -->
      <Thickness x:Key="ButtonPadding">8,2,8,3</Thickness>
      <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
      <x:Double x:Key="RadioButtonMinHeight">20</x:Double>
      <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
      <Thickness x:Key="ComboBoxPadding">6,1,0,2</Thickness>
      <Thickness x:Key="ComboBoxItemThemePadding">6,2,6,3</Thickness>
      <Thickness x:Key="ListBoxItemPadding">6,2,6,3</Thickness>
      <x:Double x:Key="MenuBarHeight">24</x:Double>
      <Thickness x:Key="MenuBarItemPadding">8,2</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePadding">8,3,8,4</Thickness>
      <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,2,8,3</Thickness>
      <Thickness x:Key="MenuFlyoutPresenterThemePadding">0,2</Thickness>
      <x:Double x:Key="TabItemMinHeight">24</x:Double>
      <x:Double x:Key="TextControlThemeMinHeight">22</x:Double>
      <Thickness x:Key="TextControlThemePadding">5,2,5,3</Thickness>
      <Thickness x:Key="FlyoutContentThemePadding">6</Thickness>
      <x:Double x:Key="ExpanderMinHeight">26</x:Double>
      <Thickness x:Key="ExpanderHeaderPadding">8,0</Thickness>
      <Thickness x:Key="ExpanderContentPadding">6,4</Thickness>
      <Thickness x:Key="ToolTipBorderThemePadding">6,3,6,4</Thickness>
      <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
      <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg">#ECEEF2</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#F7F8FA</SolidColorBrush>
          <SolidColorBrush x:Key="PanelAlt">#E1E5EC</SolidColorBrush>
          <SolidColorBrush x:Key="Toolbar">#E4E8EE</SolidColorBrush>
          <SolidColorBrush x:Key="Frame">#97A1AF</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBar">#D9E2EE</SolidColorBrush>
          <SolidColorBrush x:Key="Text">#1D2127</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#5C6470</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#2B65B0</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccent">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="StatusAccent">#8A4B00</SolidColorBrush>
          <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" /><GradientStop Offset="0.5" Color="#F1F3F6" /><GradientStop Offset="1" Color="#DDE2E9" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#F4F9FF" /><GradientStop Offset="1" Color="#CFE2F8" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="ButtonBackgroundPressed">#BFD6F2</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrush">#7E8896</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#3C7FD1</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushPressed">#2B65B0</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled">#C5CBD4</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrush">#8E98A6</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#3C7FD1</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxBorderBrush">#7E8896</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#3C7FD1</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg">#16181C</SolidColorBrush>
          <SolidColorBrush x:Key="Panel">#1D2025</SolidColorBrush>
          <SolidColorBrush x:Key="PanelAlt">#262A31</SolidColorBrush>
          <SolidColorBrush x:Key="Toolbar">#1E2126</SolidColorBrush>
          <SolidColorBrush x:Key="Frame">#4A515D</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBar">#2A2F37</SolidColorBrush>
          <SolidColorBrush x:Key="Text">#DCDDE0</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#8C9199</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#5C9BE0</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccent">#101215</SolidColorBrush>
          <SolidColorBrush x:Key="StatusAccent">#FFE0A0</SolidColorBrush>
          <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#3A3F48" /><GradientStop Offset="1" Color="#2A2E35" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#474D58" /><GradientStop Offset="1" Color="#343841" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="ButtonBackgroundPressed">#23262C</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrush">#5A6170</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#5C9BE0</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushPressed">#5C9BE0</SolidColorBrush>
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled">#3A3F48</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrush">#5A6170</SolidColorBrush>
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#7A8190</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxBorderBrush">#5A6170</SolidColorBrush>
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#5C9BE0</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
  </Style>
  <Style Selector="Border.side">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{DynamicResource StatusAccent}" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="Background" Value="{DynamicResource HeaderBar}" />
    <Setter Property="Padding" Value="5,2,5,3" />
  </Style>

  <!-- the view's tool bar -->
  <Style Selector="Border.toolbox">
    <Setter Property="Background" Value="{DynamicResource Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool Path.line">
    <Setter Property="Stroke" Value="{DynamicResource Text}" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool Path.solid">
    <Setter Property="Fill" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool:checked Path.line">
    <Setter Property="Stroke" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Border.toolbox ToggleButton.tool:checked Path.solid">
    <Setter Property="Fill" Value="{DynamicResource OnAccent}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- lists and text are framed -->
  <Style Selector="ListBox">
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- tabs: framed, the chosen one joined to its page -->
  <Style Selector="TabControl > TabItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Background" Value="{DynamicResource PanelAlt}" />
    <Setter Property="CornerRadius" Value="3,3,0,0" />
  </Style>
  <Style Selector="TabControl > TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
  </Style>
  <Style Selector="TabControl > TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="Padding" Value="5" />
  </Style>
</Styles>
