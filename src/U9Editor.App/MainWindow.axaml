<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:U9Editor.App"
        x:Class="U9Editor.App.MainWindow"
        Title="U9 Editor" Width="1280" Height="820">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open game folder…" Click="OnOpenFolder" />
        <Separator />
        <MenuItem Header="_Save map objects" InputGesture="Ctrl+S" Click="OnSave" />
        <Separator />
        <MenuItem Header="Save _picture of the view…" Click="OnSavePicture" />
        <MenuItem Header="Export changes as _mod…" Click="OnExportMod" ToolTip.Tip="A .u9mod of the saved changes (against the .orig copies the editor keeps), for the U9 Mod Manager; it holds differences only, never the game's files" />
          <Separator />
          <MenuItem Header="_Export selected object's model (glTF)…" Click="OnExportModel" ToolTip.Tip="A .glb for Blender: textures embedded, x east, y north, z up, one terrain point = 1 m" />
          <MenuItem Header="_Replace selected object's model from glTF…" Click="OnReplaceModel" ToolTip.Tip="Writes the .glb's triangles into static/sappear.flx (first time keeping .orig); every object showing that model on every map changes" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoItem" Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem x:Name="RedoItem" Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="_Copy the selected object" InputGesture="Ctrl+D" Click="OnDuplicate" />
        <MenuItem Header="Copy as _prefab (objects and ground)" InputGesture="Ctrl+C" Click="OnPrefabCopy" ToolTip.Tip="Copies the selected objects and the ground under them, to paste here or on another map" />
        <MenuItem Header="_Paste prefab…" InputGesture="Ctrl+V" Click="OnPrefabPaste" ToolTip.Tip="Its outline follows the mouse; click to paste, [ and ] turn it, Esc stops" />
        <MenuItem Header="_Delete the selected object" InputGesture="Delete" Click="OnDelete" />
        <MenuItem Header="Put it on the _ground" InputGesture="End" Click="OnDropToGround" />
        <MenuItem Header="Turn it _left (15°, Shift 1°)" InputGesture="OemOpenBrackets" Click="OnTurnLeft" />
        <MenuItem Header="Turn it _right (15°, Shift 1°)" InputGesture="OemCloseBrackets" Click="OnTurnRight" />
        <MenuItem Header="Raise it (16 units, Shift 2)" InputGesture="PageUp" Click="OnRaise" />
        <MenuItem Header="Lower it (16 units, Shift 2)" InputGesture="PageDown" Click="OnLower" />
        <Separator />
        <MenuItem Header="Trigger _scripts…" InputGesture="Ctrl+T" Click="OnOpenScriptEditor" ToolTip.Tip="The trigger script editor: every script of TRIGGERS.FLX in the trigger language" />
        <MenuItem Header="_Dialogue…" InputGesture="Ctrl+G" Click="OnOpenDialogue" ToolTip.Tip="Every conversation line (static/text.flx) by conversation, with its voice clip (sound/Speech.flx)" />
        <MenuItem Header="Combat _balance…" InputGesture="Ctrl+B" Click="OnOpenCombat" ToolTip.Tip="Hits to kill and to be killed for every creature, weapon and armour, and the editing of weapon, armour and creature stats (u9.exe's tables and NPC.FLX)" />
        <Separator />
        <MenuItem x:Name="FollowItem" Header="Dragged objects _follow the terrain" ToggleType="CheckBox" IsChecked="True" Click="OnToggleFollow" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Textures" Click="OnColourTextures" />
        <MenuItem Header="Colour by _height" Click="OnColourHeight" />
        <MenuItem Header="Colour by _texture number" Click="OnColourTexture" />
        <MenuItem Header="Colour by rotation/bit 15 _flags" Click="OnColourFlags" />
        <Separator />
        <MenuItem x:Name="ModelsItem" Header="Object _models (off: markers)" ToggleType="CheckBox" IsChecked="True" Click="OnToggleModels" />
        <MenuItem x:Name="FixedItem" Header="Fi_xed objects" ToggleType="CheckBox" IsChecked="True" Click="OnToggleFixed" />
        <MenuItem x:Name="NonfixedItem" Header="_Nonfixed objects" ToggleType="CheckBox" IsChecked="True" Click="OnToggleNonfixed" />
        <MenuItem x:Name="TerrainItem" Header="T_errain" ToggleType="CheckBox" IsChecked="True" Click="OnToggleTerrain" />
        <MenuItem x:Name="UnseenItem" Header="Hide texture 29 (never shown in the game)" ToggleType="CheckBox" IsChecked="True" Click="OnToggleUnseen" />
        <MenuItem x:Name="WaterItem" Header="_Water" ToggleType="CheckBox" IsChecked="True" Click="OnToggleWater" />
        <MenuItem x:Name="HolesItem" Header="Show _holes in magenta" ToggleType="CheckBox" Click="OnToggleHoles" />
        <MenuItem x:Name="GridItem" Header="Tile _grid (16 points)" ToggleType="CheckBox" Click="OnToggleGrid" />
        <Separator />
        <MenuItem x:Name="FlyItem" Header="_Fly camera" ToggleType="CheckBox" InputGesture="V" Click="OnToggleFly" />
        <MenuItem x:Name="TopDownItem" Header="Top-_down map" ToggleType="CheckBox" InputGesture="Tab" Click="OnToggleTopDown" />
        <MenuItem Header="_Frame the whole map" InputGesture="Home" Click="OnFrame" />
        <Separator />
        <MenuItem Header="Texture _debug">
          <MenuItem Header="Turn every quad's texture a quarter" Click="OnUvRotate" />
          <MenuItem x:Name="FlipVItem" Header="Texture rows the other way" ToggleType="CheckBox" Click="OnUvFlip" />
        </MenuItem>
        <MenuItem Header="T_heme">
          <MenuItem x:Name="ThemeLightItem" Header="_Light" ToggleType="Radio" GroupName="theme" IsChecked="True" Click="OnThemeLight" />
          <MenuItem x:Name="ThemeDarkItem" Header="_Dark" ToggleType="Radio" GroupName="theme" Click="OnThemeDark" />
        </MenuItem>
        <MenuItem x:Name="NorthItem" Header="_North is point row 0 (debug: the game puts north at the last row)" ToggleType="CheckBox" Click="OnToggleNorth" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Padding="6,3" BorderThickness="0,0,0,1" Classes="bar">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Map" VerticalAlignment="Center" />
        <ComboBox x:Name="MapBox" MinWidth="360" SelectionChanged="OnMapChanged" />
        <TextBlock x:Name="MapInfo" VerticalAlignment="Center" Opacity="0.75" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="6,2" BorderThickness="0,1,0,0" Classes="bar">
      <DockPanel>
        <TextBlock x:Name="GlText" DockPanel.Dock="Right" Opacity="0.6" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Classes="status" Margin="0,0,16,0" MaxWidth="700" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HoverText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Right" Width="380" BorderThickness="1,0,0,0" Classes="side" Padding="5">
      <DockPanel>
        <StackPanel x:Name="ObjectPanel" DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12" KeyDown="OnObjectPanelKey">
          <TextBlock Text="Selected object" FontWeight="SemiBold" />
          <TextBlock x:Name="ObjectTitle" FontSize="12" TextWrapping="Wrap" Text="Click an object to select it; drag it to move it." />
          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" x:Name="ObjectFields" IsEnabled="False">
            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditX" Grid.Column="1" FontSize="12" Margin="0,0,8,4" ToolTip.Tip="Points east (1/128 steps)" />
            <TextBlock Text="Row" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditRow" Grid.Column="3" FontSize="12" Margin="0,0,0,4" ToolTip.Tip="Points north (1/128 steps)" />
            <TextBlock Text="Z" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditZ" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,0,8,0" ToolTip.Tip="Height in object units (4 per terrain height step)" />
            <TextBlock Text="Turn °" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditYaw" Grid.Row="1" Grid.Column="3" FontSize="12" ToolTip.Tip="Degrees counter-clockwise seen from above" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ObjectButtons" IsEnabled="False">
            <Button Content="Apply" Click="OnApplyObject" ToolTip.Tip="Enter in a field does the same" />
            <Button Content="To ground" Click="OnDropToGround" />
            <Button Content="Copy" Click="OnDuplicate" />
            <Button Content="Delete" Click="OnDelete" />
          </StackPanel>
          <TextBlock x:Name="ObjectDetails" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl x:Name="SideTabs" Padding="0,4,0,0">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="Padding" Value="7,0" />
              <Setter Property="MinWidth" Value="0" />
            </Style>
          </TabControl.Styles>
          <TabControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </TabControl.ItemsPanel>
          <TabItem Header="Links" FontSize="13" ToolTip.Tip="Map links: doors, caves and teleports to other maps">
            <DockPanel>
              <TextBlock x:Name="LinksHeader" DockPanel.Dock="Top" Text="Map links" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock DockPanel.Dock="Top" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Click: show the trigger zone. Double-click: go to where it leads (opens the other map). Yellow markers are zones, violet ones arrivals." />
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0" KeyDown="OnLinkFieldsKey">
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                  <TextBlock Text="To map" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkMap" Grid.Column="1" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="Link" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkNumber" Grid.Column="3" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="Marker" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkMarker" Grid.Column="5" FontSize="12" Text="1134" />
                </Grid>
                <WrapPanel>
                  <Button Content="Retarget selected" Click="OnRetarget" Margin="0,0,4,4" ToolTip.Tip="Send the selected link to the map and link above (it gets its own script)" />
                  <Button Content="Free link" Click="OnFreeLink" Margin="0,0,4,4" ToolTip.Tip="A link number nobody uses in the destination map" />
                  <Button Content="New link at point" Click="OnNewLink" Margin="0,0,4,4" ToolTip.Tip="A map change zone at the selected ground point, to the map and link above" />
                  <Button Content="New arrival at point" Click="OnNewArrival" Margin="0,0,4,4" ToolTip.Tip="An arrival marker with the link above, at the selected ground point of this map" />
                </WrapPanel>
              </StackPanel>
              <ListBox x:Name="LinksList" FontSize="12" SelectionChanged="OnLinkSelected" DoubleTapped="OnLinkGo" />
            </DockPanel>
          </TabItem>
          <TabItem x:Name="PlaceTab" Header="Place" FontSize="13" ToolTip.Tip="Place a new object of any type">
            <DockPanel>
              <TextBox x:Name="PlaceSearch" DockPanel.Dock="Top" Watermark="Search types by name or number" FontSize="12" TextChanged="OnPlaceSearch" Margin="0,0,0,4" />
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="File" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox x:Name="PlaceKind" SelectedIndex="0" FontSize="12">
                    <ComboBoxItem Content="as the map has it" />
                    <ComboBoxItem Content="fixed (scenery)" />
                    <ComboBoxItem Content="nonfixed (items, NPCs)" />
                  </ComboBox>
                  <Button x:Name="PlaceButton" Content="Place" Click="OnPlace" />
                </StackPanel>
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           Text="Pick a type, press Place, then click the ground. Esc cancels. The new object takes its flags from one of its kind already on the map, or on another map." />
              </StackPanel>
              <ListBox x:Name="PlaceList" FontSize="12" DoubleTapped="OnPlace" />
            </DockPanel>
          </TabItem>
          <TabItem Header="Contents" FontSize="13">
            <ScrollViewer>
              <StackPanel Spacing="4">
                <TextBlock x:Name="PropHeader" FontSize="12" TextWrapping="Wrap" Text="Select a nonfixed object to see its properties and what is inside it." />
                <ListBox x:Name="PropList" FontSize="12" MaxHeight="170" SelectionChanged="OnPropSelected" />
                <StackPanel Orientation="Horizontal" Spacing="6" x:Name="PropEdit" IsEnabled="False">
                  <TextBlock Text="A" VerticalAlignment="Center" FontSize="12" />
                  <TextBox x:Name="PropA" Width="70" FontSize="12" KeyDown="OnPropKey" />
                  <TextBlock Text="B" VerticalAlignment="Center" FontSize="12" />
                  <TextBox x:Name="PropB" Width="70" FontSize="12" KeyDown="OnPropKey" />
                  <Button Content="Set" Click="OnPropSet" FontSize="12" ToolTip.Tip="Writes the two values (0-65535) of the selected property; Enter does the same. Ctrl+Z takes it back." />
                  <Button Content="Remove" Click="OnPropRemove" FontSize="12" ToolTip.Tip="Takes the selected property off the object (one undo step)" />
                </StackPanel>
                <TextBlock x:Name="PropHelpText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6" x:Name="PropAddRow" IsEnabled="False">
                  <ComboBox x:Name="PropAddId" Width="175" FontSize="12" SelectionChanged="OnPropAddPicked" ToolTip.Tip="A property it does not have yet" />
                  <TextBox x:Name="PropAddA" Width="55" FontSize="12" PlaceholderText="A" />
                  <TextBox x:Name="PropAddB" Width="55" FontSize="12" PlaceholderText="B" />
                  <Button Content="Add" Click="OnPropAdd" FontSize="12" ToolTip.Tip="Gives the object the property with these values (one undo step). A fourth property chains on a second segment, and the object then stays in its 32-point chunk when moved." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Inside" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button x:Name="PropOwnerButton" Content="Back to the object" Click="OnPropOwner" FontSize="11" IsVisible="False" />
                </StackPanel>
                <ListBox x:Name="ContentsList" FontSize="12" MaxHeight="130" SelectionChanged="OnContentSelected" />
                <StackPanel x:Name="TypePanel" Spacing="4" IsVisible="False" Margin="0,6,0,0">
                  <TextBlock x:Name="TypeHeader" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="Auto,70,Auto,70,Auto,70" RowDefinitions="Auto,Auto,Auto" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hit points" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" ToolTip.Tip="TYPES.DAT +0xD: the type's hit points (0-255)" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TypeHp" FontSize="12" ToolTip.Tip="TYPES.DAT +0xD: the type's hit points (0-255)" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Weight" VerticalAlignment="Center" FontSize="12" Margin="6,0,4,0" ToolTip.Tip="TYPES.DAT +0xA (0-255); 254 and 255 cannot be picked up" />
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="TypeWeight" FontSize="12" ToolTip.Tip="TYPES.DAT +0xA (0-255); 254 and 255 cannot be picked up" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Volume" VerticalAlignment="Center" FontSize="12" Margin="6,0,4,0" ToolTip.Tip="TYPES.DAT +0xB: how much room it takes (0-255)" />
                    <TextBox Grid.Row="0" Grid.Column="5" x:Name="TypeVolume" FontSize="12" ToolTip.Tip="TYPES.DAT +0xB: how much room it takes (0-255)" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Book" VerticalAlignment="Center" FontSize="12" Margin="0,4,4,0" ToolTip.Tip="TYPES.DAT +0xC (0-255): a book number for the type" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TypeBook" FontSize="12" Margin="0,4,0,0" ToolTip.Tip="TYPES.DAT +0xC (0-255): a book number for the type" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Model" VerticalAlignment="Center" FontSize="12" Margin="6,4,4,0" ToolTip.Tip="TYPES.DAT +6: the sappear.flx model objects of this type show unless they carry their own (nonfixed objects do)" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="TypeModel" FontSize="12" Margin="0,4,0,0" ToolTip.Tip="TYPES.DAT +6: the sappear.flx model objects of this type show unless they carry their own (nonfixed objects do)" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Usecode" VerticalAlignment="Center" FontSize="12" Margin="6,4,4,0" ToolTip.Tip="TYPES.DAT +4: the usecode class, which picks the C++ code in u9.exe that runs the type's behaviour (and what trigger scripts reach it as). Change with care." />
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="TypeUsecode" FontSize="12" Margin="0,4,0,0" ToolTip.Tip="TYPES.DAT +4: the usecode class, which picks the C++ code in u9.exe that runs the type's behaviour (and what trigger scripts reach it as). Change with care." />
                  </Grid>
                  <WrapPanel x:Name="TypeFlagPanel" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Set type" Click="OnTypeSet" FontSize="12" ToolTip.Tip="Writes the changed values into TYPES.DAT for every object of this type on every map (one undo step; Ctrl+S saves, the first time keeping TYPES.DAT.orig)" />
                    <TextBlock Opacity="0.6" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Width="250" Text="Type-wide: every object of this type, on every map." />
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="BookPanel" Spacing="4" IsVisible="False">
                  <TextBlock x:Name="BookHeader" FontWeight="SemiBold" />
                  <TextBox x:Name="BookTitle" FontSize="12" />
                  <TextBox x:Name="BookText" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" Height="190" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Set text" Click="OnBookSet" FontSize="12" ToolTip.Tip="Keeps the new title and text (one undo step); Ctrl+S writes the books file (first time keeping .orig)" />
                    <TextBlock Opacity="0.6" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Width="230"
                               Text="Lines end with CR LF; `f1, `f2 ... pick the font. Other objects showing this book change too." />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Find" FontSize="13">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox x:Name="FindText" Width="230" FontSize="12" Watermark="name, type number, #id, link:n, fixed" KeyDown="OnFindKey"
                           ToolTip.Tip="All words must match: words in the type's name, a type number, #id of an object here, link:n of a nonfixed object, fixed or nonfixed. Enter searches." />
                  <CheckBox x:Name="FindAllMaps" Content="All maps" FontSize="12" Click="OnFind" ToolTip.Tip="Search every map's object files (the first time reads them all, a second or two)" />
                </StackPanel>
                <TextBlock x:Name="FindHeader" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="Double-click a result to go there (and select it on this map)." />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                <Button Content="Select all found here" Click="OnSelectFound" FontSize="12" ToolTip.Tip="Selects every result on this map, to move, turn, copy or delete them together" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Go to" VerticalAlignment="Center" FontSize="12" />
                  <TextBox x:Name="GotoText" Width="150" FontSize="12" Watermark="x, row" KeyDown="OnGotoKey" ToolTip.Tip="A point of this map (as the status bar shows them), or map, x, row" />
                  <Button Content="Go" Click="OnGoto" FontSize="12" />
                </StackPanel>
                <TextBlock Text="Bookmarks" FontWeight="SemiBold" Margin="0,4,0,0" />
                <ListBox x:Name="BookmarkList" FontSize="12" Height="120" DoubleTapped="OnBookmarkGo" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox x:Name="BookmarkName" Width="170" FontSize="12" Watermark="name for this view" KeyDown="OnBookmarkKey" />
                  <Button Content="Add" Click="OnBookmarkAdd" FontSize="12" ToolTip.Tip="Remembers the map and the point looked at, and the camera angle" />
                  <Button Content="Delete" Click="OnBookmarkDelete" FontSize="12" />
                </StackPanel>
              </StackPanel>
              <ListBox x:Name="FindResults" FontSize="12" DoubleTapped="OnFindGo" />
            </DockPanel>
          </TabItem>
          <TabItem Header="Scenes" FontSize="13" ToolTip.Tip="In-engine scenes: camera moves between camera points (type 2218) that trigger scripts chain">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="4">
                <TextBlock x:Name="ScenesHeader" Text="Scenes" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           Text="Each scene is the camera moves one object's script starts. Click a scene to see where it starts, Play to watch it in the view; click a move to look from its camera point." />
                <ListBox x:Name="ScenesList" FontSize="12" Height="110" SelectionChanged="OnSceneSelected" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="ScenePlay" Content="Play" Click="OnScenePlay" ToolTip.Tip="Plays the scene in the 3D view (camera points hidden). Again: stop and put the view back." />
                  <Slider x:Name="SceneTime" Width="190" Minimum="0" Maximum="1" ValueChanged="OnSceneScrub" ToolTip.Tip="Drag through the scene" />
                  <TextBlock x:Name="SceneClock" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <TextBlock Text="Moves" FontWeight="SemiBold" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="0,4,0,0">
                <Expander x:Name="ScriptExpander" Header="Script" FontSize="12" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="ScriptHeader" FontSize="11" TextWrapping="Wrap" Text="Pick a scene or a move to see its script." />
                    <TextBox x:Name="ScriptText" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" AcceptsReturn="True" Height="130"
                             TextWrapping="NoWrap" ToolTip.Tip="The script in the trigger language (docs/trigger-language.md): one statement a line. The script editor (Edit menu) has the checks, completion and lists." />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Apply script" Click="OnScriptApply" FontSize="12" ToolTip.Tip="Writes the ops into the script (one undo step); every object running it changes" />
                      <Button Content="Show again" Click="OnScriptReload" FontSize="12" />
                      <Button Content="Script editor" Click="OnScriptOpenEditor" FontSize="12" ToolTip.Tip="Opens this script in the trigger script editor" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
                <Expander Header="Make scenes" FontSize="12" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="3">
                    <WrapPanel>
                      <Button Content="New scene here" Click="OnSceneNew" FontSize="12" Margin="0,0,4,4"
                              ToolTip.Tip="A trigger zone at the selected ground point; walking into it cuts the camera to a new camera point where the view is now, for the seconds above (Add move goes on from there)" />
                      <Button Content="Add move from view" Click="OnSceneAddMove" FontSize="12" Margin="0,0,4,4"
                              ToolTip.Tip="A new camera point where the view is, reached after the scene's last move with the seconds, Glide and Straight above" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" >
                      <TextBlock Text="Radius" VerticalAlignment="Center" FontSize="12" Margin="0,0,3,0" />
                      <TextBox x:Name="OrbitRadius" Grid.Column="1" Text="5" FontSize="12" Margin="0,0,5,0" ToolTip.Tip="Points from the object's middle" />
                      <TextBlock Text="Height" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="0,0,3,0" />
                      <TextBox x:Name="OrbitHeight" Grid.Column="3" Text="300" FontSize="12" Margin="0,0,5,0" ToolTip.Tip="Object units above its middle (128 = one point)" />
                      <TextBlock Text="Points" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Margin="0,0,3,0" />
                      <TextBox x:Name="OrbitCount" Grid.Column="5" Text="12" FontSize="12" Margin="0,0,5,0" ToolTip.Tip="Camera points round the lap (3 to 64)" />
                      <TextBlock Text="Lap s" Grid.Column="6" VerticalAlignment="Center" FontSize="12" Margin="0,0,3,0" />
                      <TextBox x:Name="OrbitSeconds" Grid.Column="7" Text="24" FontSize="12" ToolTip.Tip="Seconds for the whole circle" />
                    </Grid>
                    <Button Content="Orbit the selected object" Click="OnSceneOrbit" FontSize="12"
                            ToolTip.Tip="A scene that circles the selected object, always looking at it; its trigger zone goes at the selected ground point (where you clicked)" />
                  </StackPanel>
                </Expander>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0" x:Name="ShotEdit" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Seconds" VerticalAlignment="Center" FontSize="12" />
                  <TextBox x:Name="ShotSeconds" Width="60" FontSize="12" KeyDown="OnShotKey" ToolTip.Tip="How long the move takes, in half seconds (0 to 1023.5)" />
                  <CheckBox x:Name="ShotGlide" Content="Glide" FontSize="12" ToolTip.Tip="Glide there from where the camera is (B 0x8000); off: cut there and wait" />
                  <CheckBox x:Name="ShotStraight" Content="Straight" FontSize="12" ToolTip.Tip="Glide at an even speed (0x0800); off: ease in and out" />
                  <CheckBox x:Name="ShotBack" Content="Back" FontSize="12" ToolTip.Tip="Glide back to the view the camera had before the scene (0x4000)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Then run the point's" VerticalAlignment="Center" FontSize="12" />
                  <CheckBox x:Name="ShotThen1" Content="script 1" FontSize="12" ToolTip.Tip="When the time is up, run the point's first OO Trigger script (0x2000)" />
                  <CheckBox x:Name="ShotThen2" Content="script 2" FontSize="12" ToolTip.Tip="When the time is up, run the point's second OO Trigger script (0x1000)" />
                </StackPanel>
                <WrapPanel>
                  <Button Content="Set move" Click="OnShotSet" FontSize="12" Margin="0,0,4,4" ToolTip.Tip="Writes the move into its trigger script (one undo step; Ctrl+S saves TRIGGERS.FLX, first time keeping .orig). Every object running that script changes." />
                  <Button Content="Point from view" Click="OnShotFromView" FontSize="12" Margin="0,0,4,4" ToolTip.Tip="Moves the move's camera point to where the view is: the point looked at, heading, pitch and distance (one undo step)" />
                  <Button Content="Look from point" Click="OnShotLook" FontSize="12" Margin="0,0,4,4" ToolTip.Tip="Puts the view where the camera is at the end of this move" />
                </WrapPanel>
                <TextBlock x:Name="ShotInfo" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              <ListBox x:Name="ShotsList" FontSize="12" SelectionChanged="OnShotSelected" />
            </DockPanel>
          </TabItem>
          <TabItem x:Name="TerrainTab" Header="Terrain" FontSize="13">
            <StackPanel Spacing="6" x:Name="TerrainPanel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="BrushToggle" Content="Brush" Click="OnBrushToggle" ToolTip.Tip="B toggles it. While on, a left drag on the ground edits the terrain; right drag orbits, Shift+drag pans." />
                <ComboBox x:Name="BrushTool" SelectedIndex="0" FontSize="12" SelectionChanged="OnBrushChanged" DropDownClosed="OnBrushToolClosed">
                  <ComboBoxItem Content="Raise" />
                  <ComboBoxItem Content="Lower" />
                  <ComboBoxItem Content="Smooth" />
                  <ComboBoxItem Content="Flatten" />
                  <ComboBoxItem Content="Paint texture" />
                  <ComboBoxItem Content="Cut holes" />
                  <ComboBoxItem Content="Fill holes" />
                  <ComboBoxItem Content="Roughen" />
                </ComboBox>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*,40" RowDefinitions="Auto,Auto">
                <TextBlock Text="Radius" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                <Slider x:Name="BrushRadius" Grid.Column="1" Minimum="0.5" Maximum="32" Value="4" ValueChanged="OnBrushSlider" />
                <TextBlock x:Name="BrushRadiusText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="4" Margin="6,0,0,0" />
                <TextBlock Grid.Row="1" Text="Strength" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                <Slider x:Name="BrushStrength" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" Value="6" ValueChanged="OnBrushSlider" />
                <TextBlock x:Name="BrushStrengthText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="6" Margin="6,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" KeyUp="OnBrushFieldKey">
                <TextBlock Text="Flatten to" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushFlatten" Grid.Column="1" FontSize="12" Margin="0,0,6,0" PlaceholderText="first dab" />
                <TextBlock Text="Texture" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushTexture" Grid.Column="3" FontSize="12" Margin="0,0,6,0" Text="5" />
                <TextBlock Text="Frame" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushFrame" Grid.Column="5" FontSize="12" Text="0" />
              </Grid>
              <WrapPanel>
                <Button Content="Texture from selected point" Click="OnBrushPickTexture" Margin="0,0,4,4" FontSize="12" ToolTip.Tip="Click a ground point with the brush off, then this takes its texture and frame" />
                <CheckBox x:Name="BrushBlend" Content="Blend edges" IsChecked="True" FontSize="12" Click="OnBrushChanged" Margin="0,0,8,0"
                          ToolTip.Tip="Paint the texture as ground and give the edge the map's transition frames into what was there (the frame field is then not used)" />
                <CheckBox x:Name="BrushTurn" Content="Random quarter turns" IsChecked="True" FontSize="12" Click="OnBrushChanged" Margin="0,0,8,0" />
                <CheckBox x:Name="BrushFollow" Content="Objects follow the ground" IsChecked="True" FontSize="12" Click="OnBrushChanged" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Water height" VerticalAlignment="Center" FontSize="12" />
                <TextBox x:Name="WaterHeight" Width="70" FontSize="12" KeyDown="OnWaterKey" />
                <Button Content="Set" Click="OnSetWater" FontSize="12" ToolTip.Tip="The map's sea level, in point heights as the status bar shows them (Enter does the same)" />
              </StackPanel>
              <ListBox x:Name="TexturePalette" MaxHeight="132" SelectionChanged="OnPaletteSelected" Padding="0"
                       ToolTip.Tip="The map's ground textures, most used first: click one to paint it">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock x:Name="BlendInfo" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                         Text="Strength: point heights (a quarter unit each) per dab for Raise and Lower, percent of the way per dab for Smooth and Flatten. Holding the mouse still keeps raising. [ and ] change the radius; Ctrl+click takes the height (Flatten) or texture (Paint) from the ground. Ctrl+Z takes back a whole stroke; Ctrl+S writes static/terrain.N (the first time keeping terrain.N.orig)." />
            </StackPanel>
          </TabItem>
          <TabItem x:Name="PrefabTab" Header="Prefabs" FontSize="13" ToolTip.Tip="Copy objects with the ground under them and paste them elsewhere, also on other maps; keep them in a library">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="Copy" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox x:Name="PrefabWithGround" Content="With the ground, and" IsChecked="True" FontSize="12" />
                  <NumericUpDown x:Name="PrefabMargin" Value="3" Minimum="0" Maximum="32" Increment="1" FormatString="0" Width="105" FontSize="12"
                                 ToolTip.Tip="Points of ground round the objects: the edge a paste blends into the ground it lands on" />
                  <TextBlock Text="points round" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
                <Button Content="Copy the selection (Ctrl+C)" Click="OnPrefabCopy" FontSize="12" />
                <TextBlock x:Name="PrefabInfo" FontSize="11" TextWrapping="Wrap" Opacity="0.8" Text="Nothing copied yet: select objects (Ctrl+drag boxes them) and press Ctrl+C." />
                <TextBlock Text="Paste" FontWeight="SemiBold" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Ground" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox x:Name="PrefabGroundMode" SelectedIndex="2" FontSize="12" Width="190">
                    <ComboBoxItem Content="Leave the ground here" />
                    <ComboBoxItem Content="Heights" />
                    <ComboBoxItem Content="Heights and textures" />
                  </ComboBox>
                </StackPanel>
                <CheckBox x:Name="PrefabFit" Content="Fit its heights to the ground here" IsChecked="True" FontSize="12"
                          ToolTip.Tip="Raises or lowers the pasted ground as a whole so its edge meets the ground it lands on; off, the heights are pasted as copied" />
                <CheckBox x:Name="PrefabBlend" Content="Blend its edge into the ground here" IsChecked="True" FontSize="12"
                          ToolTip.Tip="Across the margin the heights fade into the ground there, and textures stop halfway" />
                <CheckBox x:Name="PrefabFollow" Content="Without ground: objects keep their height above it" IsChecked="True" FontSize="12"
                          ToolTip.Tip="Off, all objects move up or down by one amount, as the parts of a building must" />
                <CheckBox x:Name="PrefabNewLinks" Content="New link numbers (keeping their offsets)" IsChecked="True" FontSize="12"
                          ToolTip.Tip="The objects' links move up together above the map's highest, so scripts that reach link + n still find each other and nothing here is mixed up with them" />
                <CheckBox x:Name="PrefabCopyScripts" Content="Own copies of their scripts" IsChecked="True" FontSize="12"
                          ToolTip.Tip="Each script the objects run gets a new slot (with its links renumbered), so editing the copy leaves the original alone" />
                <CheckBox x:Name="PrefabClear" Content="Delete the objects already in its area" FontSize="12"
                          ToolTip.Tip="Objects of this map standing inside the prefab's area (within its margin) are deleted with the paste" />
                <Button Content="Paste… (Ctrl+V)" Click="OnPrefabPaste" FontSize="12" ToolTip.Tip="The outline follows the mouse; click to paste, [ and ] turn it a quarter, Esc stops" />
                <TextBlock Text="Library" FontWeight="SemiBold" Margin="0,4,0,0" />
                <ListBox x:Name="PrefabList" FontSize="12" Height="110" DoubleTapped="OnPrefabUse" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox x:Name="PrefabName" Width="200" FontSize="12" PlaceholderText="name for what is copied" />
                  <Button Content="Save" Click="OnPrefabSave" FontSize="12" ToolTip.Tip="Keeps what is copied as a prefab file in the library" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Paste this one" Click="OnPrefabUse" FontSize="12" />
                  <Button Content="Delete" Click="OnPrefabDelete" FontSize="12" />
                  <Button Content="Open folder" Click="OnPrefabFolder" FontSize="12" />
                </StackPanel>
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           Text="A prefab keeps the objects whole (properties, contents, chained properties) and the scripts they run, so it pastes the same into any map and any game folder. Each paste is one undo step; Ctrl+S writes the map's files (and TRIGGERS.FLX for copied scripts)." />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Left" Classes="toolbox">
      <StackPanel Spacing="2">
        <ToggleButton x:Name="ModeSelect" Classes="tool" Tag="Select" Click="OnModeButton" IsChecked="True"
                      ToolTip.Tip="Select (1): click selects, Ctrl+click adds or takes away, Ctrl+drag selects a box. Drags only move the camera: nothing is edited.">
          <Path Classes="solid" Data="M5,2 L5,17 L9,13.5 L12,19.5 L14.5,18.3 L11.6,12.5 L16.5,12.5 Z" />
        </ToggleButton>
        <ToggleButton x:Name="ModeMove" Classes="tool" Tag="Move" Click="OnModeButton"
                      ToolTip.Tip="Move (2): drag the selection to move it (it keeps its height above the ground; Esc puts it back).">
          <Path Classes="solid" Data="M10,1 L13.5,4.5 L11,4.5 L11,9 L15.5,9 L15.5,6.5 L19,10 L15.5,13.5 L15.5,11 L11,11 L11,15.5 L13.5,15.5 L10,19 L6.5,15.5 L9,15.5 L9,11 L4.5,11 L4.5,13.5 L1,10 L4.5,6.5 L4.5,9 L9,9 L9,4.5 L6.5,4.5 Z" />
        </ToggleButton>
        <ToggleButton x:Name="ModeRotate" Classes="tool" Tag="Rotate" Click="OnModeButton"
                      ToolTip.Tip="Rotate (3): drag sideways on the selection to turn it, half a degree a pixel (a group turns about its middle).">
          <Grid>
            <Path Classes="line" StrokeThickness="2" Data="M16,10.5 A6,6 0 1 1 10,4.5" />
            <Path Classes="solid" Data="M9,1 L14,4.5 L9,8 Z" />
          </Grid>
        </ToggleButton>
        <ToggleButton x:Name="ModePlace" Classes="tool" Tag="Place" Click="OnModeButton"
                      ToolTip.Tip="Place (4): each click on the ground places the type picked in the Place tab. Esc stops.">
          <Path Classes="solid" Data="M8.5,3 L11.5,3 L11.5,8.5 L17,8.5 L17,11.5 L11.5,11.5 L11.5,17 L8.5,17 L8.5,11.5 L3,11.5 L3,8.5 L8.5,8.5 Z" />
        </ToggleButton>
        <ToggleButton x:Name="ModeTerrain" Classes="tool" Tag="Terrain" Click="OnModeButton"
                      ToolTip.Tip="Terrain (5 or B): drags edit the ground with the brush set in the Terrain tab. Esc stops.">
          <Path Classes="solid" Data="M1,17 L7,6 L10,10.5 L13,5.5 L19,17 Z" />
        </ToggleButton>
        <Separator Margin="0,4" />
        <ToggleButton x:Name="CamOrbit" Classes="tool" Click="OnCameraOrbit" IsChecked="True"
                      ToolTip.Tip="Orbit camera (V switches): drags turn round the point looked at, the wheel zooms, W/A/S/D move over the ground.">
          <Grid>
            <Path Classes="line" StrokeThickness="1.6" Data="M1.5,10 A8.5,4 0 1 1 18.5,10 A8.5,4 0 1 1 1.5,10" />
            <Path Classes="solid" Data="M7,10 A3,3 0 1 1 13,10 A3,3 0 1 1 7,10" />
          </Grid>
        </ToggleButton>
        <ToggleButton x:Name="CamFly" Classes="tool" Click="OnCameraFly"
                      ToolTip.Tip="Fly camera (V switches): drags look round, W/A/S/D fly where you look, R/F up and down, Q/E turn, the wheel steps forward; Shift is faster.">
          <Path Classes="solid" Data="M1,9.5 L19,2 L12.5,18 L9.5,11.5 Z" />
        </ToggleButton>
      </StackPanel>
    </Border>
    <Grid>
      <local:MapView x:Name="View" />
      <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle x:Name="SelectBox" IsVisible="False" Stroke="#FFFF33E6" StrokeThickness="1.5" Fill="#22FF33E6" StrokeDashArray="4,3" />
      </Canvas>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="56" Height="56"
              CornerRadius="28" Background="#66000000" IsHitTestVisible="False">
        <Canvas x:Name="Compass" Width="56" Height="56">
          <Polygon Points="28,6 23,28 33,28" Fill="#E05050" />
          <Polygon Points="28,50 23,28 33,28" Fill="#DDDDDD" />
          <TextBlock Text="N" Canvas.Left="24" Canvas.Top="-16" Foreground="White" FontWeight="Bold" />
        </Canvas>
      </Border>
    </Grid>
  </DockPanel>
</Window>
