<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:U9Editor.App"
        x:Class="U9Editor.App.MainWindow"
        Title="U9 Editor" Width="1280" Height="820">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open game folder…" Click="OnOpenFolder" />
        <Separator />
        <MenuItem Header="_Save map objects" InputGesture="Ctrl+S" Click="OnSave" />
        <Separator />
        <MenuItem Header="Save _picture of the view…" Click="OnSavePicture" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoItem" Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem x:Name="RedoItem" Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="_Copy the selected object" InputGesture="Ctrl+D" Click="OnDuplicate" />
        <MenuItem Header="_Delete the selected object" InputGesture="Delete" Click="OnDelete" />
        <MenuItem Header="Put it on the _ground" InputGesture="End" Click="OnDropToGround" />
        <MenuItem Header="Turn it _left (15°, Shift 1°)" InputGesture="OemOpenBrackets" Click="OnTurnLeft" />
        <MenuItem Header="Turn it _right (15°, Shift 1°)" InputGesture="OemCloseBrackets" Click="OnTurnRight" />
        <MenuItem Header="Raise it (16 units, Shift 2)" InputGesture="PageUp" Click="OnRaise" />
        <MenuItem Header="Lower it (16 units, Shift 2)" InputGesture="PageDown" Click="OnLower" />
        <Separator />
        <MenuItem x:Name="FollowItem" Header="Dragged objects _follow the terrain" ToggleType="CheckBox" IsChecked="True" Click="OnToggleFollow" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Textures" Click="OnColourTextures" />
        <MenuItem Header="Colour by _height" Click="OnColourHeight" />
        <MenuItem Header="Colour by _texture number" Click="OnColourTexture" />
        <MenuItem Header="Colour by rotation/bit 15 _flags" Click="OnColourFlags" />
        <Separator />
        <MenuItem x:Name="ModelsItem" Header="Object _models (off: markers)" ToggleType="CheckBox" IsChecked="True" Click="OnToggleModels" />
        <MenuItem x:Name="FixedItem" Header="Fi_xed objects" ToggleType="CheckBox" IsChecked="True" Click="OnToggleFixed" />
        <MenuItem x:Name="NonfixedItem" Header="_Nonfixed objects" ToggleType="CheckBox" IsChecked="True" Click="OnToggleNonfixed" />
        <MenuItem x:Name="TerrainItem" Header="T_errain" ToggleType="CheckBox" IsChecked="True" Click="OnToggleTerrain" />
        <MenuItem x:Name="UnseenItem" Header="Hide texture 29 (never shown in the game)" ToggleType="CheckBox" IsChecked="True" Click="OnToggleUnseen" />
        <MenuItem x:Name="WaterItem" Header="_Water" ToggleType="CheckBox" IsChecked="True" Click="OnToggleWater" />
        <MenuItem x:Name="HolesItem" Header="Show _holes in magenta" ToggleType="CheckBox" Click="OnToggleHoles" />
        <MenuItem x:Name="GridItem" Header="Tile _grid (16 points)" ToggleType="CheckBox" Click="OnToggleGrid" />
        <Separator />
        <MenuItem x:Name="TopDownItem" Header="Top-_down map" ToggleType="CheckBox" InputGesture="Tab" Click="OnToggleTopDown" />
        <MenuItem Header="_Frame the whole map" InputGesture="Home" Click="OnFrame" />
        <Separator />
        <MenuItem Header="Texture _debug">
          <MenuItem Header="Turn every quad's texture a quarter" Click="OnUvRotate" />
          <MenuItem x:Name="FlipVItem" Header="Texture rows the other way" ToggleType="CheckBox" Click="OnUvFlip" />
        </MenuItem>
        <MenuItem x:Name="NorthItem" Header="_North is point row 0 (debug: the game puts north at the last row)" ToggleType="CheckBox" Click="OnToggleNorth" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Map" VerticalAlignment="Center" />
        <ComboBox x:Name="MapBox" MinWidth="360" SelectionChanged="OnMapChanged" />
        <TextBlock x:Name="MapInfo" VerticalAlignment="Center" Opacity="0.75" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="6,3" BorderThickness="0,1,0,0" BorderBrush="#33FFFFFF">
      <DockPanel>
        <TextBlock x:Name="GlText" DockPanel.Dock="Right" Opacity="0.6" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="#FFE0A0" Margin="0,0,16,0" MaxWidth="700" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HoverText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Right" Width="380" BorderThickness="1,0,0,0" BorderBrush="#33FFFFFF" Padding="6">
      <DockPanel>
        <StackPanel x:Name="ObjectPanel" DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12" KeyDown="OnObjectPanelKey">
          <TextBlock Text="Selected object" FontWeight="SemiBold" />
          <TextBlock x:Name="ObjectTitle" FontSize="12" TextWrapping="Wrap" Text="Click an object to select it; drag it to move it." />
          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" x:Name="ObjectFields" IsEnabled="False">
            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditX" Grid.Column="1" FontSize="12" Margin="0,0,8,4" ToolTip.Tip="Points east (1/128 steps)" />
            <TextBlock Text="Row" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditRow" Grid.Column="3" FontSize="12" Margin="0,0,0,4" ToolTip.Tip="Points north (1/128 steps)" />
            <TextBlock Text="Z" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditZ" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,0,8,0" ToolTip.Tip="Height in object units (4 per terrain height step)" />
            <TextBlock Text="Turn °" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="EditYaw" Grid.Row="1" Grid.Column="3" FontSize="12" ToolTip.Tip="Degrees counter-clockwise seen from above" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ObjectButtons" IsEnabled="False">
            <Button Content="Apply" Click="OnApplyObject" ToolTip.Tip="Enter in a field does the same" />
            <Button Content="To ground" Click="OnDropToGround" />
            <Button Content="Copy" Click="OnDuplicate" />
            <Button Content="Delete" Click="OnDelete" />
          </StackPanel>
          <TextBlock x:Name="ObjectDetails" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl x:Name="SideTabs" Padding="0,4,0,0">
          <TabItem Header="Map links" FontSize="13">
            <DockPanel>
              <TextBlock x:Name="LinksHeader" DockPanel.Dock="Top" Text="Map links" FontWeight="SemiBold" Margin="0,0,0,2" />
              <TextBlock DockPanel.Dock="Top" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Click: show the trigger zone. Double-click: go to where it leads (opens the other map). Yellow markers are zones, violet ones arrivals." />
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0" KeyDown="OnLinkFieldsKey">
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                  <TextBlock Text="To map" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkMap" Grid.Column="1" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="Link" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkNumber" Grid.Column="3" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="Marker" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                  <TextBox x:Name="LinkMarker" Grid.Column="5" FontSize="12" Text="1134" />
                </Grid>
                <WrapPanel>
                  <Button Content="Retarget selected" Click="OnRetarget" Margin="0,0,4,4" ToolTip.Tip="Send the selected link to the map and link above (it gets its own script)" />
                  <Button Content="Free link" Click="OnFreeLink" Margin="0,0,4,4" ToolTip.Tip="A link number nobody uses in the destination map" />
                  <Button Content="New link at point" Click="OnNewLink" Margin="0,0,4,4" ToolTip.Tip="A map change zone at the selected ground point, to the map and link above" />
                  <Button Content="New arrival at point" Click="OnNewArrival" Margin="0,0,4,4" ToolTip.Tip="An arrival marker with the link above, at the selected ground point of this map" />
                </WrapPanel>
              </StackPanel>
              <ListBox x:Name="LinksList" FontSize="12" SelectionChanged="OnLinkSelected" DoubleTapped="OnLinkGo" />
            </DockPanel>
          </TabItem>
          <TabItem Header="Place object" FontSize="13">
            <DockPanel>
              <TextBox x:Name="PlaceSearch" DockPanel.Dock="Top" Watermark="Search types by name or number" FontSize="12" TextChanged="OnPlaceSearch" Margin="0,0,0,4" />
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="File" VerticalAlignment="Center" FontSize="12" />
                  <ComboBox x:Name="PlaceKind" SelectedIndex="0" FontSize="12">
                    <ComboBoxItem Content="as the map has it" />
                    <ComboBoxItem Content="fixed (scenery)" />
                    <ComboBoxItem Content="nonfixed (items, NPCs)" />
                  </ComboBox>
                  <Button x:Name="PlaceButton" Content="Place" Click="OnPlace" />
                </StackPanel>
                <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                           Text="Pick a type, press Place, then click the ground. Esc cancels. The new object takes its flags from one of its kind already on the map, or on another map." />
              </StackPanel>
              <ListBox x:Name="PlaceList" FontSize="12" DoubleTapped="OnPlace" />
            </DockPanel>
          </TabItem>
          <TabItem Header="Terrain" FontSize="13">
            <StackPanel Spacing="6" x:Name="TerrainPanel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="BrushToggle" Content="Brush" Click="OnBrushToggle" ToolTip.Tip="B toggles it. While on, a left drag on the ground edits the terrain; right drag orbits, Shift+drag pans." />
                <ComboBox x:Name="BrushTool" SelectedIndex="0" FontSize="12" SelectionChanged="OnBrushChanged" DropDownClosed="OnBrushToolClosed">
                  <ComboBoxItem Content="Raise" />
                  <ComboBoxItem Content="Lower" />
                  <ComboBoxItem Content="Smooth" />
                  <ComboBoxItem Content="Flatten" />
                  <ComboBoxItem Content="Paint texture" />
                  <ComboBoxItem Content="Cut holes" />
                  <ComboBoxItem Content="Fill holes" />
                  <ComboBoxItem Content="Roughen" />
                </ComboBox>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*,40" RowDefinitions="Auto,Auto">
                <TextBlock Text="Radius" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                <Slider x:Name="BrushRadius" Grid.Column="1" Minimum="0.5" Maximum="32" Value="4" ValueChanged="OnBrushSlider" />
                <TextBlock x:Name="BrushRadiusText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="4" Margin="6,0,0,0" />
                <TextBlock Grid.Row="1" Text="Strength" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                <Slider x:Name="BrushStrength" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" Value="6" ValueChanged="OnBrushSlider" />
                <TextBlock x:Name="BrushStrengthText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="6" Margin="6,0,0,0" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" KeyUp="OnBrushFieldKey">
                <TextBlock Text="Flatten to" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushFlatten" Grid.Column="1" FontSize="12" Margin="0,0,6,0" PlaceholderText="first dab" />
                <TextBlock Text="Texture" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushTexture" Grid.Column="3" FontSize="12" Margin="0,0,6,0" Text="5" />
                <TextBlock Text="Frame" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                <TextBox x:Name="BrushFrame" Grid.Column="5" FontSize="12" Text="0" />
              </Grid>
              <WrapPanel>
                <Button Content="Texture from selected point" Click="OnBrushPickTexture" Margin="0,0,4,4" FontSize="12" ToolTip.Tip="Click a ground point with the brush off, then this takes its texture and frame" />
                <CheckBox x:Name="BrushBlend" Content="Blend edges" IsChecked="True" FontSize="12" Click="OnBrushChanged" Margin="0,0,8,0"
                          ToolTip.Tip="Paint the texture as ground and give the edge the map's transition frames into what was there (the frame field is then not used)" />
                <CheckBox x:Name="BrushTurn" Content="Random quarter turns" IsChecked="True" FontSize="12" Click="OnBrushChanged" Margin="0,0,8,0" />
                <CheckBox x:Name="BrushFollow" Content="Objects follow the ground" IsChecked="True" FontSize="12" Click="OnBrushChanged" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Water height" VerticalAlignment="Center" FontSize="12" />
                <TextBox x:Name="WaterHeight" Width="70" FontSize="12" KeyDown="OnWaterKey" />
                <Button Content="Set" Click="OnSetWater" FontSize="12" ToolTip.Tip="The map's sea level, in point heights as the status bar shows them (Enter does the same)" />
              </StackPanel>
              <ListBox x:Name="TexturePalette" MaxHeight="132" SelectionChanged="OnPaletteSelected" Padding="0"
                       ToolTip.Tip="The map's ground textures, most used first: click one to paint it">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock x:Name="BlendInfo" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap"
                         Text="Strength: point heights (a quarter unit each) per dab for Raise and Lower, percent of the way per dab for Smooth and Flatten. Holding the mouse still keeps raising. [ and ] change the radius; Ctrl+click takes the height (Flatten) or texture (Paint) from the ground. Ctrl+Z takes back a whole stroke; Ctrl+S writes static/terrain.N (the first time keeping terrain.N.orig)." />
            </StackPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
    <Grid>
      <local:MapView x:Name="View" />
      <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle x:Name="SelectBox" IsVisible="False" Stroke="#FFFF33E6" StrokeThickness="1.5" Fill="#22FF33E6" StrokeDashArray="4,3" />
      </Canvas>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="56" Height="56"
              CornerRadius="28" Background="#66000000" IsHitTestVisible="False">
        <Canvas x:Name="Compass" Width="56" Height="56">
          <Polygon Points="28,6 23,28 33,28" Fill="#E05050" />
          <Polygon Points="28,50 23,28 33,28" Fill="#DDDDDD" />
          <TextBlock Text="N" Canvas.Left="24" Canvas.Top="-16" Foreground="White" FontWeight="Bold" />
        </Canvas>
      </Border>
    </Grid>
  </DockPanel>
</Window>
