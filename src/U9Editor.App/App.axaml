<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="U9Editor.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <!-- the classic, compact look with its Light and Dark schemes -->
    <StyleInclude Source="/Look.axaml" />
    <!-- the trigger script editor (AvaloniaEdit) -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>
</Application>
